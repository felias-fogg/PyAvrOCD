# Testbed runtime state, when the shared folder is extras/testbed itself
extras/testbed/hosts/
extras/testbed/jobs/
extras/testbed/taken/
extras/testbed/results/
extras/testbed/staging/

# The simavr archives come from "make install-simavr", so they bring its
# headers along. Nothing reads them at run time, and packer.sh drops them
# from the tool package -- eight copies of the same 190 KB are not worth
# carrying in the repository.
extras/binaries/*/include/

# Same for the rest of the simavr development files: the static library, the
# pkg-config files (whose prefix is the CI build directory anyway) and the bare
# .so symlink that only the linker uses. What has to ship is bin/ plus the
# versioned .so.1 files beside it; the development files live in the simavr
# release archives, where they belong.
extras/binaries/*/lib/*.a
extras/binaries/*/lib/pkgconfig/
extras/binaries/*/lib/libsimavr*.so

# The i686 Linux client is built in the release workflow now, in a 32-bit
# Debian container on an ordinary x86_64 runner, so it no longer has to sit in
# the repository -- this was the one folder that added an 11 MB blob to the
# history with every release. The VERSION file beside it was a reminder to
# rebuild the client by hand; nothing ever read it.
extras/binaries/i686-linux-gnu/pyavrocd
extras/binaries/i686-linux-gnu/pyavrocd-util/
extras/binaries/i686-linux-gnu/VERSION
